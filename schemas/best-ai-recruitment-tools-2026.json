          "@type": "ListItem",
          "position": 6,
          "item": {
            "@type": "SoftwareApplication",
            "name": "Alex",
            "applicationCategory": "BusinessApplication",
            "applicationSubCategory": "AI Interview Platform",
            "description": "Autonomous AI phone interviewing platform for automated screening",
            "url": "https://www.alex.com"
          }
        },
        {
          "@type": "ListItem",
          "position": 7,
          "item": {
            "@type": "SoftwareApplication",
            "name": "Eightfold AI",
            "applicationCategory": "BusinessApplication",
            "applicationSubCategory": "Talent Intelligence",
            "description": "Enterprise talent intelligence platform with AI-powered hiring and retention",
            "url": "https://www.eightfold.ai"
          }
        },
        {
          "@type": "ListItem",
          "position": 8,
          "item": {
            "@type": "SoftwareApplication",
            "name": "HireVue",
            "applicationCategory": "BusinessApplication",
            "applicationSubCategory": "Video Interview Platform",
            "description": "Video interview assessments at scale with structured evaluation",
            "url": "https://www.hirevue.com"
          }
        }
      ]
    });
  }
  
  // Example: Add FAQ schema to more articles
  // if (slug === "will-ai-replace-recruiters-the-definitive-answer-2025") {
  //   schemaData["@graph"].push({
  //     "@type": "FAQPage",
  //     // ... FAQ content
  //   });
  // }
  
  // Add more conditional schemas for other articles
  // Example: Add HowTo schema for guide articles
  if (slug.includes('guide') || slug.includes('how-to')) {
    // You can add HowTo schema here in the future
  }
  
  // Inject schema into page
  const script = document.createElement('script');
  script.type = 'application/ld+json';
  script.text = JSON.stringify(schemaData);
  document.head.appendChild(script);
  
  console.log('✅ Schema injected for:', slug);
  console.log('📊 Schema types:', schemaData['@graph'].map(s => s['@type']).join(', '));
  
