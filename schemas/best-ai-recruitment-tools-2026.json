            "description": "Talent CRM with AI-powered outreach automation and pipeline management",
            "url": "https://www.gem.com"
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "item": {
            "@type": "SoftwareApplication",
            "name": "Paradox",
            "applicationCategory": "BusinessApplication",
