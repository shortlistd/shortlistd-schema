/**
 * BLOG SCHEMA BUILDER - GitHub Hosted File
 * 
 * File location: /blog-schema.js
 * GitHub repo: shortlistd/shortlistd-schema
 * CDN URL: 'https://cdn.jsdelivr.net/gh/shortlistd/shortlistd-schema@main/schemas/best-ai-recruitment-tools-2026.json'
 * 
