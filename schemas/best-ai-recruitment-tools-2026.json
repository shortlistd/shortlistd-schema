    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": `${articleUrl}#article`,
        "headline": title,
        "description": description,
        "image": {
          "@type": "ImageObject",
          "url": fullImageUrl,
          "width": 1200,
          "height": 630
        },
        "author": {
          "@type": "Person",
          "@id": `${baseUrl}/about#adil`,
